# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local Open ECG Digitizer PoC artifacts (never commit models, source checkout, or outputs)
/.venv-open-ecg/
/.oed-venv/
/.open-ecg-cache/
/.local-models/open-ecg-digitizer/
/tools/open-ecg-digitizer-poc/input/
/tools/open-ecg-digitizer-poc/output/
**/__pycache__/
*.pyc
